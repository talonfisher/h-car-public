# H-CAR Environment Variables
# Copy to .env and fill in real values. Never commit .env.

# Database - Neon Postgres (see NEON_SETUP.md)
# Get this from your Neon project dashboard
DATABASE_URL=postgresql://user:password@host.neon.tech/hcar?sslmode=require

# Square (production)
SQUARE_ACCESS_TOKEN=your-production-access-token-here
SQUARE_APPLICATION_ID=sq0idp-AjjPPKKmlIAWk17Uf6sQvw
SQUARE_LOCATION_ID=L5A30BMAGNY4E
SQUARE_PLAN_VARIATION_ID=XU5OAQ4SZB4GA4DYN65KZYFD

# JWT secret for session tokens (generate a random string)
JWT_SECRET=change-this-to-a-random-secret-string

# Google Health API (Fitbit data) - see GOOGLE_SETUP.md
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
BASE_URL=http://localhost:3000

# Garmin Health API - see GARMIN_SETUP.md
# Apply at https://developer.garmin.com/gc-developer-program/
# Garmin requires approval as a legal entity (company, not individual).
# Talon Fisher Contracting qualifies as a sole proprietorship.
GARMIN_CLIENT_ID=your-garmin-client-id
GARMIN_CLIENT_SECRET=your-garmin-client-secret

# 64 hex chars (openssl rand -hex 32); encrypts stored Google tokens
TOKEN_ENCRYPTION_KEY=generate-with-openssl-rand-hex-32

# Random string guarding /api/admin/* (daily sync cron)
ADMIN_SYNC_KEY=change-this-to-a-random-string

# Email alerts (emergency contact Act alerts via SMTP, Nodemailer).
# If these are not set, alerts are skipped gracefully and logged.
# Example for Gmail: host smtp.gmail.com, port 587, user your Gmail
# address, pass a Gmail app password (not your normal password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=H-CAR <your-email@gmail.com>

# SMS alerts (Twilio). Act alerts go to emergency contacts by text
# as well as email. Twilio has a free trial with $15 credit.
# If these are not set, SMS is skipped and email remains the channel.
# Set the Twilio number's messaging webhook to
# https://h-car.onrender.com/api/alerts/sms-reply so a contact can
# acknowledge by replying YES to the text.
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# Web push alerts (VAPID keys). Lets the phone wake the user for the
# "Are you okay?" check-in even when the app is closed.
# Generate with: npx web-push generate-vapid-keys
# If these are not set, push is skipped and the check-in only appears
# when the app is open.
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# Server port (Render sets this automatically)
PORT=3000
